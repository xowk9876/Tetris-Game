{
  "name": "tetris-game-react",
  "version": "1.0.0",
  "type": "module",
  "description": "React와 Phaser로 만든 PC·모바일 테트리스 게임",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node --test tests/production/search.test.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "prebuild": "npm test",
    "check": "npm run build && npm audit"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "24.x"
  }
}
